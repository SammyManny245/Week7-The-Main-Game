<Window x:Class="StoryGameApp.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="CS110 Story Game" 
        Width="960" 
        Height="760" 
        MinWidth="600" 
        MinHeight="560" 
        Background="#02335e" 
        Foreground="#19ad09">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="THE STORY OF MAXWELL / CS110" Foreground="#fabb78" FontSize="16"/>
            <TextBlock x:Name="SlideCounter" FontSize="16" Margin="0,8"/>
            <Image x:Name="StoryImage" Height="260" Stretch="Uniform" AutomationProperties.Name="Current story illustration"/>
            <TextBlock x:Name="StoryTextBlock" FontSize="22" TextWrapping="Wrap" Margin="0,14"/>
            <TextBlock x:Name="ImageDescription" TextWrapping="Wrap" FontSize="14"/>

            <WrapPanel Margin="0,14">
                <Button x:Name="BackButton" Content="_Back" Click="BackButton_Click" Padding="18,10" Margin="0,0,8,8" Background="#7ae2f5"/>
                <Button x:Name="NextButton" Content="_Next" Click="NextButton_Click" Padding="18,10" Margin="0,0,8,8" Background="#7ae2f5"/>
                <Button x:Name="RestartButton" Content="_Restart" Click="RestartButton_Click" Padding="18,10" Margin="0,0,8,8" Background="#9e0808"/>
            </WrapPanel>

            <StackPanel x:Name="CapturePanel"/>
            <TextBlock Text="SCREEN CAPTURE / Primary display" FontSize="16" Foreground="#EED19B"/>

            <WrapPanel Margin="0,8">
                <Button Content="_Capture screen" Click="CaptureButton_Click" Padding="14,8" Margin="0,0,8,8"/>
                <Button x:Name="SaveCaptureButton" Content="_Save PNG" Click="SaveCaptureButton_Click" IsEnabled="False" Padding="14,8" Margin="0,0,8,8" Background="#FFD88686"/>
                <Button x:Name="ClearCaptureButton" Content="C_lear" Click="ClearCaptureButton_Click" IsEnabled="False" Padding="14,8" Margin="0,0,8,8"/>
            </WrapPanel>

            <Image x:Name="CapturePreview" Height="140" Stretch="Uniform" AutomationProperties.Name="Captured screen preview"/>
        </StackPanel>
    </ScrollViewer>
</Window>